CITEGUARD_MOCK=1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
MAX_RETRIES=3
MAX_FILE_MB=10

# 检索策略：auto（默认，配置了 http 编码器才启用融合）/ lexical / hybrid
CITEGUARD_RETRIEVER=auto
# 稠密通道编码器：hashing（默认，离线、无需 Key）/ http / off
CITEGUARD_EMBEDDING_PROVIDER=hashing
CITEGUARD_EMBEDDING_DIM=512
# 仅当 CITEGUARD_EMBEDDING_PROVIDER=http 时必填
CITEGUARD_EMBEDDING_BASE_URL=
CITEGUARD_EMBEDDING_MODEL=
CITEGUARD_EMBEDDING_API_KEY=
# 词面相关性下限，同时是拒答门槛
CITEGUARD_MIN_COVERAGE=0.15
